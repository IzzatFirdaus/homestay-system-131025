        "autoprefixer": "^10.4.2",
        "axe-core": "^4.11.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.6.2",
        "sass": "^1.93.2",
        "sass-embedded": "^1.93.2",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
