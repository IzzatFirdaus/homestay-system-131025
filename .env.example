APP_NAME="homestay-system"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestay_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@motac.gov.my"
MAIL_FROM_NAME="Homestay System"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ========================================
# Development User Credentials
# ========================================
# These credentials are used only in local/development environments
# to seed default test users. Change the password for your local testing.

DEV_SUPER_ADMIN_EMAIL="superadmin@motac.gov.my"
DEV_SUPER_ADMIN_PASSWORD="password123"

DEV_NATIONAL_ADMIN_EMAIL="admin@motac.gov.my"
DEV_NATIONAL_ADMIN_PASSWORD="password123"

DEV_PENGANALISIS_EMAIL="penganalisis@motac.gov.my"
DEV_PENGANALISIS_PASSWORD="password123"

DEV_PEMERHATI_EMAIL="pemerhati@motac.gov.my"
DEV_PEMERHATI_PASSWORD="password123"

# Default password for all other seeded users
DEV_DEFAULT_USER_PASSWORD="password123"
